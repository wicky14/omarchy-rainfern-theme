# Rainfern in btop. The main background is left empty so the terminal's glass
# shows the wallpaper through it.
theme[main_bg]=""
theme_background=false

theme[main_fg]="#d5e2cc"
theme[title]="#9ecc78"
theme[hi_fg]="#a4d48c"
theme[selected_bg]="#22402c"
theme[selected_fg]="#f1f7ea"
theme[inactive_fg]="#647a68"
theme[proc_misc]="#7fb869"

theme[cpu_box]="#5e9cb0"
theme[mem_box]="#5e9cb0"
theme[net_box]="#5e9cb0"
theme[proc_box]="#5e9cb0"
theme[div_line]="#1b3323"

theme[temp_start]="#a4d48c"
theme[temp_mid]="#6fb0a0"
theme[temp_end]="#5e9cb0"

theme[cpu_start]="#a4d48c"
theme[cpu_mid]="#6fb0a0"
theme[cpu_end]="#5e9cb0"

theme[free_start]="#d4c57e"
theme[free_mid]="#c58b5a"
theme[free_end]="#c58b5a"

theme[cached_start]="#6fb0a0"
theme[cached_mid]="#5e9cb0"
theme[cached_end]="#5e9cb0"

theme[available_start]="#9ecc78"
